{\n  "name": "multi-credits-pool",\n  "version": "0.4.2",\n  "description": "多账号 WorkBuddy：管理登录凭据、每天自动签到、汇总各账号积分与套餐，并把多账号模型轮换注册成 DSH 的一个 provider",\n  "type": "module",\n  "main": "index.js",\n  "files": [\n    "index.js",\n    "client.js",\n    "cordis.patch.yml",\n    "bin",\n    "src",\n    "docs",\n    "README.md",\n    "TESTING.md"\n  ],\n  "bin": {\n    "multi-credits-pool": "bin/credits.js"\n  },\n  "exports": {\n    ".": "./index.js",\n    "./client": "./client.js",\n    "./cordis.patch.yml": "./cordis.patch.yml",\n    "./package.json": "./package.json"\n  },\n  "keywords": [\n    "dsh",\n    "dsh-plugin",\n    "deepseek-harness",\n    "workbuddy",\n    "multi-account"\n  ],\n  "engines": {\n    "node": ">=22.19.0"\n  },\n  "dsh": {\n    "bundle": {\n      "patch": "./cordis.patch.yml"\n    },\n    "client": {\n      "platform": "web",\n      "inject": [\n        "@deepseek-ai/dsh-client-ui-renderer",\n        "@deepseek-ai/dsh-client-ui-settings",\n        "@deepseek-ai/dsh-client-ui-settings-plugins",\n        "@deepseek-ai/dsh-client-locale"\n      ]\n    }\n  },\n  "repository": {\n    "type": "git",\n    "url": "git+https://github.com/dzdeng7-sudo/multi-credits-pool.git"\n  },\n  "homepage": "https://github.com/dzdeng7-sudo/multi-credits-pool#readme",\n  "bugs": {\n    "url": "https://github.com/dzdeng7-sudo/multi-credits-pool/issues"\n  },\n  "publishConfig": {\n    "access": "public"\n  },\n  "license": "MIT"\n}\n